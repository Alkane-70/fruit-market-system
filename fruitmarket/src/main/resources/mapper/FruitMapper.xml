<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fruitmarket.mapper.FruitMapper">
    <select id="queryAllData" resultType="com.fruitmarket.bean.FruitItem">
        SELECT number,name,price,unit FROM fruit
    </select>

    <select id="queryDataForCon" resultType="com.fruitmarket.bean.FruitItem">
        SELECT number,name,price,unit FROM fruit
        <where>
            <if test="number != null and number != ''">
                AND number = #{number}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="price != null and price != ''">
                AND price = #{price}
            </if>
            <if test="unit != null and unit != ''">
                AND unit LIKE CONCAT('%',#{unit},'%')
            </if>
        </where>
    </select>

    <insert id="addFruitItem">
        INSERT INTO fruit(number,name,price,unit)
        VALUES(#{number},#{name},#{price},#{unit})
    </insert>

    <update id="updateFruitItem">
        UPDATE fruit SET name = #{name},price = #{price},unit = #{unit}
        WHERE number = #{number}
    </update>

    <delete id="delFruitItem">
        DELETE FROM fruit WHERE number = #{number}
    </delete>

</mapper>